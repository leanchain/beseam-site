{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beseam",
  "main": "main.js",
  "compatibility_date": "2026-07-18",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // Serve the exported Next 404 page instead of an empty body.
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/scan/verify", "/", "/scan"],
  },
  "send_email": [
    {
      "name": "REVIEW_EMAIL",
      "destination_address": "contact@beseam.com",
      "allowed_sender_addresses": ["website@beseam.com"],
    },
  ],
  "observability": {
    "enabled": true,
  },
}
