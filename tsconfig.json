{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-arrow/types/**/*.ts",
    ".next-arrow2/types/**/*.ts",
    ".next-base/types/**/*.ts",
    ".next-dev-b/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-v6/types/**/*.ts",
    ".next-v7/types/**/*.ts",
    ".next-v8/types/**/*.ts",
    ".next-vB/types/**/*.ts",
    ".next-vD/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-vE/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "archive",
    "deleted"
  ]
}
