# Copy to .env and fill in real values. Never commit the filled-in file.

# Analytics
NEXT_PUBLIC_RELEASE_GUARD=true
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_ENABLE_ANALYTICS=true
# Hotjar site id (digits only, from Hotjar > Settings > Sites). Unset = no Hotjar.
NEXT_PUBLIC_HOTJAR_ID=

# App links (dev server uses .env.development; builds use .env.production)
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3123

# SendPulse lead capture runs in the Cloudflare Worker (main.js), not in Next.
# Set these as Worker secrets, not here:
#   bunx wrangler secret put SENDPULSE_CLIENT_ID
#   bunx wrangler secret put SENDPULSE_CLIENT_SECRET
#   bunx wrangler secret put SENDPULSE_ADDRESS_BOOK_ID
# For local `wrangler dev`, put the same three keys in an untracked .dev.vars file.
TREVRA_CAPTURE_API_BASE_URL=http://localhost:7002
TREVRA_CAPTURE_SOURCE_ID=cap_xxxxxxxxxxxxxxxxxxxx
TREVRA_CAPTURE_SECRET=trv_capture_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
