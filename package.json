{
  "name": "beseam",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "(fuser -k -n tcp ${LP_PORT:-7002} 2>/dev/null || true); (fuser -k -n tcp ${LP_NEXT_PORT:-7003} 2>/dev/null || true)",
    "dev": "concurrently -k -n next,worker -c cyan,magenta \"npm:dev:next\" \"npm:dev:worker\"",
    "dev:next": "NEXT_PUBLIC_APP_BASE_URL=${NEXT_PUBLIC_APP_BASE_URL:-${LOCAL_APP_BASE:-http://localhost:3123}} NEXT_DIST_DIR=.next-dev next dev --turbopack -p ${LP_NEXT_PORT:-7003}",
    "dev:worker": "wrangler dev --config wrangler.dev.jsonc --port ${LP_PORT:-7002} --var DEV_ORIGIN:http://localhost:${LP_NEXT_PORT:-7003} --var API_BASE_URL:${LOCAL_API_BASE:-http://localhost:8123/api} --var APP_BASE_URL:${LOCAL_APP_BASE:-http://localhost:3123}",
    "dev:next-only": "NEXT_DIST_DIR=.next-dev next dev --turbopack -p ${LP_PORT:-7002}",
    "build": "next build",
    "postbuild": "node scripts/fix-export-locales.mjs",
    "brand:assets": "bash scripts/generate-brand-assets.sh",
    "test:worker": "node --test main.test.mjs",
    "start": "next start",
    "lint": "next lint",
    "test:i18n": "node --test src/i18n/locale-rules.test.mjs",
    "test": "npm run test:worker && npm run test:i18n && npm run test:scan-state",
    "check:export": "node scripts/check-export.mjs",
    "test:scan-state": "bun test src/components/beseam/answer-check-state.test.mjs"
  },
  "dependencies": {
    "@calcom/embed-react": "^1.5.3",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.518.0",
    "next": "^15.5.7",
    "next-mdx-remote": "^5.0.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@next/eslint-plugin-next": "^15.3.0",
    "@tailwindcss/postcss": "^4.1.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.2.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.24.0",
    "eslint-config-next": "15.4.6",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "kill-port": "^2.0.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.1.10",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.42.0"
  }
}
